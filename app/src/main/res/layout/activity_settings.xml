<?xml version="1.0" encoding="utf-8"?>
<!-- Settings (spec §7): mist page, top bar, scrollable cards (permission, language, translation), footer, language sheet. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- .st-top padding 10/12/4, gap 6 -->
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal"
            android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="4dp">
            <FrameLayout
                android:id="@+id/back"
                android:layout_width="48dp" android:layout_height="48dp"
                android:clickable="true" android:focusable="true"
                android:contentDescription="@string/settings_back">
                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:layout_gravity="center"
                    android:importantForAccessibility="no" android:src="@drawable/ic_back" />
            </FrameLayout>
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:letterSpacing="0.02" android:text="@string/settings_title"
                android:textColor="#1E1B4B" android:textSize="28sp" android:textStyle="bold" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/scroll"
            android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:clipChildren="false" android:clipToPadding="false"
            android:scrollbars="none">
            <!-- body padding 6/18/28, gap 16 -->
            <LinearLayout
                android:id="@+id/body"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:clipChildren="false" android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="18dp" android:paddingTop="6dp" android:paddingEnd="18dp" android:paddingBottom="28dp">

                <!-- ===== permission card (§7.2) ===== -->
                <LinearLayout
                    android:id="@+id/permCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="18dp">

                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="12dp"
                        android:letterSpacing="0.06" android:text="@string/perm_section"
                        android:textColor="#6B5FA8" android:textSize="13sp" android:textStyle="bold" />

                    <us.jhangy.textify.CaptureDemoView
                        android:id="@+id/demo"
                        android:layout_width="match_parent" android:layout_height="178dp"
                        android:importantForAccessibility="noHideDescendants">
                        <LinearLayout
                            android:tag="demoScreen"
                            android:layout_width="176dp" android:layout_height="200dp"
                            android:layout_gravity="top|center_horizontal" android:layout_marginTop="18dp"
                            android:orientation="vertical">
                            <LinearLayout
                                android:layout_width="match_parent" android:layout_height="30dp"
                                android:background="#FFFFFF" android:gravity="center_vertical" android:orientation="horizontal"
                                android:paddingStart="8dp" android:paddingEnd="8dp">
                                <View android:tag="avatar" android:layout_width="16dp" android:layout_height="16dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp" android:text="@string/demo_header"
                                    android:textColor="#1D2330" android:textSize="10sp" android:textStyle="bold" />
                            </LinearLayout>
                            <!-- padding 8, gap 6; max width 86% of 160dp = 138dp; bubble padding 7/4; 9.5sp × 1.45 = 13.8sp -->
                            <LinearLayout
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:orientation="vertical" android:padding="8dp">
                                <TextView android:tag="line"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:maxWidth="138dp" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp"
                                    android:text="@string/demo_line_1" android:textSize="9.5sp" app:lineHeight="13.8sp" />
                                <TextView android:tag="line"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                                    android:maxWidth="138dp" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp"
                                    android:text="@string/demo_line_2" android:textSize="9.5sp" app:lineHeight="13.8sp" />
                                <TextView android:tag="line_me"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                                    android:layout_gravity="end"
                                    android:maxWidth="138dp" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp"
                                    android:text="@string/demo_line_3" android:textSize="9.5sp" app:lineHeight="13.8sp" />
                                <TextView android:tag="line"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                                    android:maxWidth="138dp" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp"
                                    android:text="@string/demo_line_4" android:textSize="9.5sp" app:lineHeight="13.8sp" />
                                <TextView android:tag="line_me"
                                    android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                                    android:layout_gravity="end"
                                    android:maxWidth="138dp" android:paddingStart="7dp" android:paddingTop="4dp" android:paddingEnd="7dp" android:paddingBottom="4dp"
                                    android:text="@string/demo_line_6" android:textSize="9.5sp" app:lineHeight="13.8sp" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:tag="demoChip"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:paddingStart="14dp" android:paddingTop="8dp" android:paddingEnd="14dp" android:paddingBottom="8dp"
                            android:singleLine="true" android:text="@string/demo_chip"
                            android:textColor="#9A3412" android:textSize="12.5sp" android:textStyle="bold" />
                    </us.jhangy.textify.CaptureDemoView>

                    <us.jhangy.textify.StepTrackView
                        android:id="@+id/track"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginTop="16dp" android:layout_marginEnd="4dp" />

                    <!-- .pstat margin 14/4/0 -->
                    <TextView
                        android:id="@+id/statusTitle"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginTop="14dp" android:layout_marginEnd="4dp"
                        android:textColor="#1E1B4B" android:textSize="19sp" android:textStyle="bold" />
                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginTop="3dp" android:layout_marginEnd="4dp"
                        android:textColor="#6B5FA8" android:textSize="13sp" app:lineHeight="20.2sp" />

                    <TextView
                        android:id="@+id/cta"
                        android:layout_width="match_parent" android:layout_height="52dp"
                        android:layout_marginTop="14dp" android:gravity="center"
                        android:text="@string/perm_cta" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                        android:visibility="gone" />

                    <!-- .prow margin-top 12, padding 10/10/10/16, gap 12 -->
                    <LinearLayout
                        android:id="@+id/switchRow"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:clickable="true" android:focusable="true"
                        android:gravity="center_vertical" android:orientation="horizontal"
                        android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp"
                        android:visibility="gone">
                        <TextView
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginEnd="12dp" android:text="@string/perm_switch"
                            android:textColor="#1E1B4B" android:textSize="14.5sp" android:textStyle="bold" />
                        <FrameLayout
                            android:id="@+id/switchTrack"
                            android:layout_width="52dp" android:layout_height="32dp"
                            android:clipChildren="false" android:importantForAccessibility="no">
                            <!-- on position: x = 4 + 20 -->
                            <View android:id="@+id/switchThumb"
                                android:layout_width="24dp" android:layout_height="24dp"
                                android:layout_gravity="center_vertical|start" android:layout_marginStart="24dp" />
                        </FrameLayout>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/langCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="18dp">

                    <!-- .sec with small hint (weight 500, alpha .8, letter-spacing 0), gap 8 -->
                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="12dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:letterSpacing="0.06" android:text="@string/lang_section"
                            android:textColor="#6B5FA8" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:alpha="0.8" android:text="@string/lang_section_hint"
                            android:textColor="#6B5FA8" android:textSize="13sp" />
                    </LinearLayout>

                    <us.jhangy.textify.LanguagePreviewView
                        android:id="@+id/preview"
                        android:layout_width="match_parent" android:layout_height="214dp"
                        android:padding="10dp" android:clipChildren="false" android:clipToPadding="false"
                        android:importantForAccessibility="noHideDescendants">
                        <!-- .shot: padding 10/12/0, children spaced by 8dp top margins; background, scrim, avatar/row/tag styling and tag position are set by LanguagePreviewView -->
                        <LinearLayout
                            android:tag="previewShot"
                            android:layout_width="match_parent" android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:gravity="center_vertical" android:orientation="horizontal">
                                <View android:tag="avatar" android:layout_width="24dp" android:layout_height="24dp" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp" android:text="@string/preview_header"
                                    android:textColor="#1D2330" android:textSize="12.5sp" android:textStyle="bold" />
                            </LinearLayout>
                            <!-- row = .pln: padding 10/5; text 13sp × 1.35 = 17.6sp; tag 9.5sp bold #7C3AED padding 6/1 -->
                            <FrameLayout android:tag="zh"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                                android:layout_gravity="start" android:clipChildren="false"
                                android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp">
                                <TextView android:tag="text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/preview_zh" android:textColor="#1D2330" android:textSize="13sp" app:lineHeight="17.6sp" />
                                <TextView android:tag="tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:paddingStart="6dp" android:paddingTop="1dp" android:paddingEnd="6dp" android:paddingBottom="1dp"
                                    android:text="@string/tag_zh" android:textColor="#7C3AED" android:textSize="9.5sp" android:textStyle="bold" />
                            </FrameLayout>
                            <FrameLayout android:tag="en"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                                android:layout_gravity="end" android:clipChildren="false"
                                android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp">
                                <TextView android:tag="text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/preview_en" android:textColor="#1D2330" android:textSize="13sp" app:lineHeight="17.6sp" />
                                <TextView android:tag="tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:paddingStart="6dp" android:paddingTop="1dp" android:paddingEnd="6dp" android:paddingBottom="1dp"
                                    android:text="@string/tag_en" android:textColor="#7C3AED" android:textSize="9.5sp" android:textStyle="bold" />
                            </FrameLayout>
                            <FrameLayout android:tag="ja"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                                android:layout_gravity="start" android:clipChildren="false"
                                android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp">
                                <TextView android:tag="text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/preview_ja" android:textColor="#1D2330" android:textSize="13sp" app:lineHeight="17.6sp" />
                                <TextView android:tag="tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:paddingStart="6dp" android:paddingTop="1dp" android:paddingEnd="6dp" android:paddingBottom="1dp"
                                    android:text="@string/tag_ja" android:textColor="#7C3AED" android:textSize="9.5sp" android:textStyle="bold" />
                            </FrameLayout>
                            <FrameLayout android:tag="ko"
                                android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                                android:layout_gravity="end" android:clipChildren="false"
                                android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp">
                                <TextView android:tag="text" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/preview_ko" android:textColor="#1D2330" android:textSize="13sp" app:lineHeight="17.6sp" />
                                <TextView android:tag="tag" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:paddingStart="6dp" android:paddingTop="1dp" android:paddingEnd="6dp" android:paddingBottom="1dp"
                                    android:text="@string/tag_ko" android:textColor="#7C3AED" android:textSize="9.5sp" android:textStyle="bold" />
                            </FrameLayout>
                        </LinearLayout>
                    </us.jhangy.textify.LanguagePreviewView>

                    <!-- .tg margin-top 14, gap 10, toggles 78dp, glyph 20sp/800, sub 11.5sp/600, gap 2 -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginTop="14dp" android:clipChildren="false" android:orientation="horizontal">
                        <us.jhangy.textify.LanguageToggleView
                            android:id="@+id/toggleZh"
                            android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1"
                            android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                                <TextView android:tag="glyph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/lang_zh" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:tag="sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="@string/lang_zh_sub" android:textSize="11.5sp" android:textStyle="bold" />
                            </LinearLayout>
                        </us.jhangy.textify.LanguageToggleView>
                        <us.jhangy.textify.LanguageToggleView
                            android:id="@+id/toggleJa"
                            android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                                <TextView android:tag="glyph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/lang_ja" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:tag="sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="@string/lang_ja_sub" android:textSize="11.5sp" android:textStyle="bold" />
                            </LinearLayout>
                        </us.jhangy.textify.LanguageToggleView>
                        <us.jhangy.textify.LanguageToggleView
                            android:id="@+id/toggleKo"
                            android:layout_width="0dp" android:layout_height="78dp" android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:layout_gravity="center" android:gravity="center_horizontal" android:orientation="vertical">
                                <TextView android:tag="glyph" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/lang_ko" android:textSize="20sp" android:textStyle="bold" />
                                <TextView android:tag="sub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="@string/lang_ko_sub" android:textSize="11.5sp" android:textStyle="bold" />
                            </LinearLayout>
                        </us.jhangy.textify.LanguageToggleView>
                    </LinearLayout>

                    <!-- .notice height 54 -->
                    <FrameLayout
                        android:id="@+id/notice"
                        android:layout_width="match_parent" android:layout_height="54dp" android:clipChildren="false">
                        <TextView android:id="@+id/noteRest"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginStart="4dp" android:layout_marginTop="16dp" android:layout_marginEnd="4dp"
                            android:text="@string/lang_latin_note" android:textColor="#6B5FA8" android:textSize="12.5sp" />
                        <LinearLayout android:id="@+id/noteBlock"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="8dp" android:alpha="0" android:translationY="-8dp"
                            android:orientation="horizontal"
                            android:paddingStart="14dp" android:paddingTop="10dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
                            <View android:id="@+id/noteBar" android:layout_width="6dp" android:layout_height="match_parent" />
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:layout_marginStart="10dp" android:text="@string/lang_block"
                                android:textColor="#1E1B4B" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <!-- .tl padding 14/14/12, corner 20 -->
                    <LinearLayout
                        android:id="@+id/timeline"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="14dp" android:paddingTop="14dp" android:paddingEnd="14dp" android:paddingBottom="12dp">
                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:text="@string/speed_label" android:textColor="#6B5FA8" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:id="@+id/speedValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#4C1D95" android:textSize="17sp" android:textStyle="bold" />
                        </LinearLayout>
                        <us.jhangy.textify.SpeedLanesView
                            android:id="@+id/lanes"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:layout_marginTop="10dp" android:layout_marginBottom="6dp" />
                        <!-- 12.5sp × 1.55 = 19.4sp, #1E1B4B 70% = #B31E1B4B -->
                        <TextView android:id="@+id/speedDesc"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:textColor="#B31E1B4B" android:textSize="12.5sp" app:lineHeight="19.4sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 「翻譯」 card (translation spec §4, prism-tide #trCard); background set in code -->
                <LinearLayout
                    android:id="@+id/trCard"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false" android:clipToPadding="false"
                    android:orientation="vertical"
                    android:paddingStart="16dp" android:paddingTop="16dp" android:paddingEnd="16dp" android:paddingBottom="18dp">

                    <LinearLayout
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:layout_marginStart="4dp" android:layout_marginEnd="4dp" android:layout_marginBottom="12dp"
                        android:orientation="horizontal">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:letterSpacing="0.06" android:text="@string/tr_section"
                            android:textColor="#6B5FA8" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" android:alpha="0.8" android:text="@string/tr_section_hint"
                            android:textColor="#6B5FA8" android:textSize="13sp" />
                    </LinearLayout>

                    <!-- .tpv looping preview (prism-tide note 10); .rows margin-top 14 -->
                    <us.jhangy.textify.TranslatePreviewView
                        android:id="@+id/trPreview"
                        android:layout_width="match_parent" android:layout_height="118dp"
                        android:layout_marginBottom="14dp"
                        android:importantForAccessibility="no" />

                    <!-- .rows: target + Wi-Fi-only (prow: min 56dp, padding 16/10/10/10) -->
                    <LinearLayout
                        android:id="@+id/trRows"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <LinearLayout
                            android:id="@+id/targetRow"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal"
                            android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp"
                            android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/tr_target" android:textColor="#1E1B4B" android:textSize="14.5sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="@string/tr_target_sub" android:textColor="#6B5FA8" android:textSize="12sp" />
                            </LinearLayout>
                            <TextView android:id="@+id/targetValue" android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:textColor="#7C3AED" android:textSize="14.5sp" android:textStyle="bold" />
                            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:layout_marginStart="4dp"
                                android:importantForAccessibility="no" android:src="@drawable/ic_chevron" />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/wifiRow"
                            android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                            android:minHeight="56dp" android:gravity="center_vertical" android:orientation="horizontal"
                            android:paddingStart="16dp" android:paddingTop="10dp" android:paddingEnd="10dp" android:paddingBottom="10dp"
                            android:clickable="true" android:focusable="true">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                                android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:text="@string/tr_wifi" android:textColor="#1E1B4B" android:textSize="14.5sp" android:textStyle="bold" />
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp" android:text="@string/tr_wifi_sub" android:textColor="#6B5FA8" android:textSize="12sp" />
                            </LinearLayout>
                            <!-- settings-final .switch 52×32, thumb 24dp at 4dp -->
                            <FrameLayout android:id="@+id/wifiSwitch" android:layout_width="52dp" android:layout_height="32dp"
                                android:clipChildren="false" android:importantForAccessibility="no">
                                <View android:id="@+id/wifiTrackOff" android:layout_width="match_parent" android:layout_height="match_parent" />
                                <View android:id="@+id/wifiTrackOn" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" />
                                <View android:id="@+id/wifiThumb" android:layout_width="24dp" android:layout_height="24dp"
                                    android:layout_gravity="start|center_vertical" android:layout_marginStart="4dp" />
                            </FrameLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- .mh margin 16/6/8 -->
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:layout_marginTop="16dp" android:layout_marginEnd="6dp" android:layout_marginBottom="8dp"
                        android:baselineAligned="true" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/tr_models" android:textColor="#6B5FA8" android:textSize="13sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:alpha="0.85" android:text="@string/tr_models_hint" android:textColor="#6B5FA8" android:textSize="12sp" />
                    </LinearLayout>

                    <!-- .wells: rows added in code -->
                    <LinearLayout
                        android:id="@+id/modelWell"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="vertical" android:padding="4dp" />

                    <LinearLayout
                        android:id="@+id/dlBtn"
                        android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="12dp"
                        android:gravity="center" android:orientation="horizontal"
                        android:clickable="true" android:focusable="true">
                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:importantForAccessibility="no" android:src="@drawable/ic_download" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
                            android:text="@string/tr_predownload" android:textColor="#4C1D95" android:textSize="15sp" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:layout_marginStart="6dp" android:layout_marginTop="10dp" android:layout_marginEnd="6dp"
                        android:orientation="horizontal">
                        <ImageView android:layout_width="15dp" android:layout_height="15dp" android:layout_marginTop="2dp"
                            android:importantForAccessibility="no" android:src="@drawable/ic_info" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:layout_marginStart="6dp" android:lineSpacingMultiplier="1.2"
                            android:text="@string/tr_note" android:textColor="#6B5FA8" android:textSize="12.5sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="18dp" android:gravity="center"
                    android:text="@string/settings_foot" android:textColor="#6B5FA8" android:textSize="12.5sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
    <!-- language sheet (prism-tide .sheet): in-window, opened from the 「翻譯」 card; height capped in code -->
    <View
        android:id="@+id/sheetScrim"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:alpha="0" android:background="#2E1E1B4B"
        android:clickable="true" android:importantForAccessibility="no"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:clickable="true" android:clipChildren="false"
        android:orientation="vertical" android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp" android:paddingTop="12dp" android:paddingEnd="22dp" android:paddingBottom="10dp">
            <View android:id="@+id/sheetGrip" android:layout_width="40dp" android:layout_height="4dp"
                android:layout_gravity="center_horizontal" android:layout_marginBottom="12dp" />
            <TextView android:id="@+id/sheetTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="4dp" android:textColor="#1E1B4B" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:id="@+id/sheetSub" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="#6B5FA8" android:textSize="12.5sp" />
        </LinearLayout>
        <ScrollView
            android:id="@+id/sheetScroll"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout android:id="@+id/sheetList"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="10dp" android:paddingEnd="10dp" android:paddingBottom="22dp" />
        </ScrollView>
    </LinearLayout>
</FrameLayout>
